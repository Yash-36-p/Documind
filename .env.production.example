# DocuMind Production Environment Variables

# Django Security
SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost

# Database (PostgreSQL)
DB_NAME=documind
DB_USER=documind
DB_PASSWORD=choose_a_strong_database_password
DB_HOST=db
DB_PORT=5432

# Redis & Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Google OAuth (Optional - for live Google Cloud integration)
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Web Port (defaults to 80)
PORT=80
