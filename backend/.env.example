# DocuMind Backend Environment Configuration
DEBUG=True
SECRET_KEY=documind-super-secret-key-change-in-production-2026
ALLOWED_HOSTS=*

# Database (Leave blank to use default SQLite, or specify PostgreSQL URL)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/documind
# DB_NAME=documind
# DB_USER=postgres
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_PORT=5432

# Celery & Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=True

